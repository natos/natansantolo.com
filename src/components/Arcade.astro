---
import { getLangFromUrl, useTranslations } from '../i18n';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<p class="only-desktop">{t('arcade.text')}</p>
<section id="arcade" class="only-desktop">
  <figure id="snake-game" class="handheld">
    <div id="snake-canvas"></div>
  </figure>
</section>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pixi.js/5.1.3/pixi.min.js"></script>
<script is:inline src="/assets/js/snake.js"></script>
