---
import { getLangFromUrl, useTranslations, bookUrl, localizePath, sections } from '../i18n';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const book = bookUrl(lang);
const articles = localizePath(`/${sections.post[lang]}/`, lang);
---

<header class="hero">
  <div class="hero__body">
    <p class="eyebrow">{t('site.description')}</p>
    <h1 class="hero__name">Natan Santolo</h1>
    <p class="lead hero__lead">{t('hero.lead')}</p>
    <div class="hero__cta">
      <a class="btn-primary" href={book}>
        {t('hero.ctaBook')} <span aria-hidden="true">→</span>
      </a>
      <a class="btn-ghost" href={articles}>{t('hero.ctaWriting')}</a>
    </div>
  </div>
  <div class="hero__portrait natan-photo">
    <video
      id="natan-video"
      class="natan-video"
      autoplay
      muted
      loop
      playsinline
      poster="/assets/NatanSantoloPhoto.jpg"
    >
      <source src="/assets/NatanSantoloVideo.mp4" type="video/mp4" />
      <img src="/assets/NatanSantoloPhoto.jpg" alt="Natan Santolo" />
    </video>
  </div>
</header>
<script is:inline src="/assets/js/perspective.js"></script>
