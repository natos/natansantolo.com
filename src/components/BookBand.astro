---
import { getLangFromUrl, useTranslations, bookUrl } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const href = bookUrl(lang);
const cover = '/assets/images/the-augmented-designer/introduction.png';
---

<section class="book-band" aria-labelledby="book-band-title">
  <div class="book-band__inner">
    <div class="book-band__cover">
      <img src={cover} alt={t('home.bookTitle')} loading="lazy" />
    </div>
    <div class="book-band__body">
      <p class="eyebrow">{t('home.bookEyebrow')}</p>
      <h2 id="book-band-title" class="book-band__title">{t('home.bookTitle')}</h2>
      <p class="book-band__text">{t('home.bookText')}</p>
      <a class="btn-primary btn-primary--invert" href={href}>
        {t('home.bookCta')} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
