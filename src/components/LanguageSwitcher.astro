---
import { getLangFromUrl, useTranslations, languages, defaultLang, type Lang } from '../i18n';

interface Props {
  /** The equivalent path in the *other* language. Falls back to that lang's home. */
  altPath?: string;
}
const { altPath } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const other: Lang = lang === 'en' ? 'es' : 'en';
const t = useTranslations(lang);
const fallback = other === defaultLang ? '/' : `/${other}/`;
const href = altPath ?? fallback;
---

<a class="lang-switch" href={href} lang={other} hreflang={other} title={languages[other]}>
  {t('lang.switch')}
</a>
