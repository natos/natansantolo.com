---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getChapters, getBookIndex, readingTime } from '../../lib/content';
import { chapterUrlByKey, bookUrlByKey, type BookKey, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
  bookKey?: BookKey | string;
  coverImage?: string;
  fallbackTitle?: string;
  fallbackDescription?: string;
  altPath?: string;
}
const {
  lang,
  altPath,
  bookKey = 'the-augmented-designer',
  coverImage,
  fallbackTitle,
  fallbackDescription,
} = Astro.props;
const index = await getBookIndex(lang, bookKey);
const chapters = await getChapters(lang, bookKey);
const title = index?.data.title ?? fallbackTitle ?? 'The Augmented Designer';
const image = coverImage ?? '/assets/images/the-augmented-designer/introduction.png';
const description = index?.data.description ?? fallbackDescription;
const alternates = { en: bookUrlByKey('en', bookKey), es: bookUrlByKey('es', bookKey) };
const firstChapter = chapters[0];
const totalMinutes = chapters.reduce((sum, ch) => sum + readingTime(ch), 0);
const startLabel = lang === 'es' ? 'Empezar a leer' : 'Start reading';
const chaptersLabel = lang === 'es' ? 'capítulos' : 'chapters';
const minLabel = lang === 'es' ? 'min de lectura' : 'min read';
---

<BaseLayout title={title} altPath={altPath} alternates={alternates} extraStyles={['/assets/css/book.css']}>
  <main class="wrap book-landing">
    <section class="book-hero">
      {
        image && (
          <div class="book-hero__cover">
            <img src={image} alt={title} />
          </div>
        )
      }
      <div class="book-hero__body">
        <h1>{title}</h1>
        {description && <p class="lead">{description}</p>}
        <p class="book-hero__meta">
          {chapters.length} {chaptersLabel}
          <span aria-hidden="true">·</span>
          {totalMinutes} {minLabel}
        </p>
        {
          firstChapter && (
            <a class="btn-primary" href={chapterUrlByKey(lang, bookKey, firstChapter.data.slug)}>
              {startLabel} <span aria-hidden="true">→</span>
            </a>
          )
        }
      </div>
    </section>

    <ol class="chapter-index">
      {
        chapters.map((ch) => (
          <li>
            <a href={chapterUrlByKey(lang, bookKey, ch.data.slug)}>
              <span class="chapter-index__title">{ch.data.title}</span>
              <span class="chapter-index__time">{readingTime(ch)} {minLabel}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </main>
</BaseLayout>
