---
import { getLangFromUrl, useTranslations, type Lang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  /** hreflang alternates: map of lang -> absolute-or-relative path */
  alternates?: Partial<Record<Lang, string>>;
  /** Extra <link> stylesheet hrefs (e.g. book.css) */
  extraStyles?: string[];
  /** Absolute-or-relative path to a per-page Open Graph image. */
  ogImage?: string;
}

const { title, description, alternates, extraStyles = [], ogImage: ogImageProp } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const siteTitle = 'Natan Santolo';
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const desc = description ?? t('site.description');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const feedHref = lang === 'en' ? '/index.xml' : '/es/index.xml';
const ogImage = new URL(ogImageProp ?? '/assets/og-banner.png', Astro.site).href;
const ogLocale = lang === 'es' ? 'es_ES' : 'en_US';
---

<meta charset="utf-8" />
<title>{pageTitle}</title>
<meta name="author" content="Natan Santolo" />
<meta name="description" content={desc} />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<script is:inline>
  // No-flash theme: apply the saved preference before first paint.
  (function () {
    try {
      var t = localStorage.getItem('theme');
      if (t === 'dark' || t === 'light') {
        document.documentElement.setAttribute('data-theme', t);
      }
    } catch (e) {}
  })();
</script>
<link rel="stylesheet" href="/assets/css/tokens.css" />
<link rel="stylesheet" href="/assets/css/base.css" />
<link rel="stylesheet" href="/assets/css/style.css" />
{extraStyles.map((href) => <link rel="stylesheet" href={href} />)}
<link rel="canonical" href={canonical} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={siteTitle}
  href={feedHref}
/>
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#faf7f0" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#16150f" media="(prefers-color-scheme: dark)" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Merriweather+Sans:ital,wght@0,400;0,700;1,400&family=Merriweather:ital,wght@0,400;0,700;0,900;1,400&display=swap"
  rel="stylesheet"
/>
{
  alternates &&
    Object.entries(alternates).map(([hl, href]) => (
      <link rel="alternate" hreflang={hl} href={new URL(href, Astro.site).href} />
    ))
}
{
  alternates && alternates.en && (
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site).href} />
  )
}
<meta name="generator" content={Astro.generator} />

<!-- Open Graph / Twitter -->
<meta property="og:type" content={title ? 'article' : 'website'} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={siteTitle} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={ogImage} />
