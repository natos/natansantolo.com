---
import { getLangFromUrl, useTranslations, homeUrl, bookUrl, localizePath, sections } from '../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** Path to the equivalent page in the other language, for the switcher. */
  altPath?: string;
}
const { altPath } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const articlesUrl = localizePath(`/${sections.post[lang]}/`, lang);
const bookHref = bookUrl(lang);

const path = Astro.url.pathname;
const isWriting = path.includes(`/${sections.post[lang]}`);
const isBook = path.includes(`/${sections.book[lang]}`);
---

<nav class="site-nav" id="top" aria-label="Primary">
  <div class="site-nav__inner">
    <a class="brand" href={homeUrl(lang)}>
      <span class="brand__mark" aria-hidden="true">NS</span>
      <span class="brand__name">Natan Santolo</span>
    </a>

    <div class="site-nav__links">
      <a href={articlesUrl} class:list={['site-nav__link', { 'is-active': isWriting }]}>
        {t('nav.articles')}
      </a>
      <a href={bookHref} class:list={['site-nav__link', { 'is-active': isBook }]}>
        {t('nav.book')}
      </a>
    </div>

    <div class="site-nav__utils">
      <LanguageSwitcher altPath={altPath} />
      <ThemeToggle />
    </div>
  </div>
</nav>
