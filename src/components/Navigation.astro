---
import {
  getLangFromUrl,
  useTranslations,
  homeUrl,
  bookUrlByKey,
  booksHubUrl,
  localizePath,
  sections,
  books,
} from '../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** Path to the equivalent page in the other language, for the switcher. */
  altPath?: string;
}
const { altPath } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const articlesUrl = localizePath(`/${sections.post[lang]}/`, lang);
const booksHref = booksHubUrl(lang);
const designerBookHref = bookUrlByKey(lang, 'the-augmented-designer');
const teamBookHref = bookUrlByKey(lang, 'the-augmented-team');

const path = Astro.url.pathname;
const isWriting = path.includes(`/${sections.post[lang]}`);
const isBook = path.includes(`/${books['the-augmented-designer'][lang]}`);
const isTeamBook = path.includes(`/${books['the-augmented-team'][lang]}`);
const isBooksHub = path.includes(`/${sections.booksHub[lang]}`);
const isBooks = isBook || isTeamBook || isBooksHub;
---

<nav class="site-nav" id="top" aria-label="Primary">
  <div class="site-nav__inner">
    <a class="brand" href={homeUrl(lang)}>
      <span class="brand__mark" aria-hidden="true">
        <video
          class="brand__video"
          autoplay
          muted
          loop
          playsinline
          poster="/assets/NatanSantoloPhoto.jpg"
        >
          <source src="/assets/NatanSantoloVideo.mp4" type="video/mp4" />
          <img src="/assets/NatanSantoloPhoto.jpg" alt="" />
        </video>
      </span>
      <span class="brand__name">Natan Santolo</span>
    </a>

    <div class="site-nav__links">
      <a href={articlesUrl} class:list={['site-nav__link', { 'is-active': isWriting }]}>
        {t('nav.articles')}
      </a>
      <details class="site-nav__dropdown" open={isBooks ? true : undefined}>
        <summary class:list={['site-nav__link', 'site-nav__dropdown-trigger', { 'is-active': isBooks }]}>
          {t('nav.book')}
        </summary>
        <div class="site-nav__dropdown-menu">
          <a href={teamBookHref} class:list={['site-nav__dropdown-item', { 'is-active': isTeamBook }]}>
            {t('nav.bookTeam')}
          </a>
          <a href={designerBookHref} class:list={['site-nav__dropdown-item', { 'is-active': isBook }]}>
            {t('nav.bookDesigner')}
          </a>
          <a href={booksHref} class:list={['site-nav__dropdown-item', 'site-nav__dropdown-item--all', { 'is-active': isBooksHub }]}>
            {t('nav.booksAll')}
          </a>
        </div>
      </details>
    </div>

    <div class="site-nav__utils">
      <LanguageSwitcher altPath={altPath} />
      <ThemeToggle />
    </div>
  </div>
</nav>
