---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, homeUrl, bookUrl, localizePath, sections } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const isEs = lang === 'es';

const pageTitle = isEs ? 'Página no encontrada' : 'Page not found';
const description = isEs
  ? 'La página que buscas no existe o fue movida.'
  : 'The page you are looking for does not exist or has moved.';

const copy = {
  eyebrow: isEs ? 'Error 404' : 'Error 404',
  title: isEs ? 'No encontramos esta página.' : "We couldn't find this page.",
  lead: isEs
    ? 'Puede que el enlace esté roto o que la URL ya no exista. Aquí tienes algunos caminos para volver al contenido.'
    : 'The link may be broken, or the URL no longer exists. Here are a few paths back to the content.',
  ctaHome: isEs ? 'Volver al inicio' : 'Back to home',
  ctaWriting: isEs ? 'Ir a escritos' : 'Go to writing',
  ctaBook: isEs ? 'Ir al libro' : 'Go to the book',
};

const writingHref = localizePath(`/${sections.post[lang]}/`, lang);
const bookHref = bookUrl(lang);
const homeHref = homeUrl(lang);
---

<BaseLayout title={pageTitle} description={description}>
  <main class="wrap not-found" data-reveal>
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.title}</h1>
    <p class="lead not-found__lead">{copy.lead}</p>

    <div class="not-found__actions">
      <a class="btn-primary" href={homeHref}>
        {copy.ctaHome} <span aria-hidden="true">→</span>
      </a>
      <a class="btn-ghost" href={writingHref}>{copy.ctaWriting}</a>
      <a class="btn-ghost" href={bookHref}>{copy.ctaBook}</a>
    </div>
  </main>
</BaseLayout>
