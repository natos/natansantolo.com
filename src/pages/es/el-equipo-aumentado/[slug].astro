---
import Chapter from '../../../components/pages/Chapter.astro';
import { getChapters, counterpartChapterUrl } from '../../../lib/content';
import { chapterUrlByKey } from '../../../i18n';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const chapters = await getChapters('es', 'the-augmented-team');
  return chapters.map((chapter) => ({
    params: { slug: chapter.data.slug },
    props: { chapter },
  }));
}) satisfies GetStaticPaths;

const { chapter } = Astro.props;
const altPath = await counterpartChapterUrl(chapter, 'en', 'the-augmented-team');
const self = chapterUrlByKey('es', 'the-augmented-team', chapter.data.slug);
const alternates = { es: self, en: altPath };
---

<Chapter {chapter} lang="es" bookKey="the-augmented-team" {altPath} {alternates} />
